[{"title":"List all cheeses","content":"Returns a paginated list of cheeses in the store. Results can be filtered by status and sorted by name or creation date.\n\nThe response includes cursor-based pagination. Use the `nextCursor` value from","url":"/api-reference/index.html#operation-cheeses-get","method":"get","path":"/cheeses","tab":"API Reference","category":"Endpoints"},{"title":"Add a new cheese","content":"Add a new cheese to the store inventory. The cheese name must be unique within its category.","url":"/api-reference/index.html#operation-cheeses-post","method":"post","path":"/cheeses","tab":"API Reference","category":"Endpoints"},{"title":"Update an existing cheese","content":"Replace an existing cheese with updated data. The cheese ID in the body must match an existing cheese.","url":"/api-reference/index.html#operation-cheeses-put","method":"put","path":"/cheeses","tab":"API Reference","category":"Endpoints"},{"title":"Find cheeses by status","content":"Multiple status values can be provided as comma-separated strings. Returns all cheeses matching any of the given statuses.","url":"/api-reference/index.html#operation-cheeses-findbystatus-get","method":"get","path":"/cheeses/findByStatus","tab":"API Reference","category":"Endpoints"},{"title":"Find cheeses by tags","content":"Multiple tags can be provided as comma-separated strings (e.g. `?tags=blue,italian,aged`).\n\n**Deprecated:** Use `GET /cheeses?tags=blue,italian` query parameter instead.\n","url":"/api-reference/index.html#operation-cheeses-findbytags-get","method":"get","path":"/cheeses/findByTags","tab":"API Reference","category":"Endpoints"},{"title":"Get cheese by ID","content":"Returns detailed information about a specific cheese, including its category, tags, and current availability status.","url":"/api-reference/index.html#operation-cheeses-cheeseid-get","method":"get","path":"/cheeses/{cheeseId}","tab":"API Reference","category":"Endpoints"},{"title":"Update cheese with form data","content":"Updates specific fields of a cheese using form data. Only provided fields are updated.","url":"/api-reference/index.html#operation-cheeses-cheeseid-post","method":"post","path":"/cheeses/{cheeseId}","tab":"API Reference","category":"Endpoints"},{"title":"Delete a cheese","content":"Permanently removes a cheese from the store. This action cannot be undone. Any pending orders for this cheese will be cancelled.","url":"/api-reference/index.html#operation-cheeses-cheeseid-delete","method":"delete","path":"/cheeses/{cheeseId}","tab":"API Reference","category":"Endpoints"},{"title":"Upload a cheese image","content":"Upload a photo of the cheese. Supports JPEG, PNG, and WebP formats. Maximum file size is 10MB.","url":"/api-reference/index.html#operation-cheeses-cheeseid-uploadimage-post","method":"post","path":"/cheeses/{cheeseId}/uploadImage","tab":"API Reference","category":"Endpoints"},{"title":"Get store inventory","content":"Returns a map of cheese status codes to quantities, representing the current inventory levels.","url":"/api-reference/index.html#operation-store-inventory-get","method":"get","path":"/store/inventory","tab":"API Reference","category":"Endpoints"},{"title":"Place a cheese order","content":"Place an order to purchase cheese from the store. The cheese must be in `available` status.\n\nOrders are processed asynchronously. Use the returned order ID to check status via `GET /store/order/{order","url":"/api-reference/index.html#operation-store-order-post","method":"post","path":"/store/order","tab":"API Reference","category":"Endpoints"},{"title":"Get order by ID","content":"Retrieve details of a specific order. For testing, use order IDs between 1 and 10.","url":"/api-reference/index.html#operation-store-order-orderid-get","method":"get","path":"/store/order/{orderId}","tab":"API Reference","category":"Endpoints"},{"title":"Cancel an order","content":"Cancel a pending order. Orders that have already been shipped cannot be cancelled.","url":"/api-reference/index.html#operation-store-order-orderid-delete","method":"delete","path":"/store/order/{orderId}","tab":"API Reference","category":"Endpoints"},{"title":"Create a customer account","content":"Register a new customer account. The username and email must be unique.","url":"/api-reference/index.html#operation-customer-post","method":"post","path":"/customer","tab":"API Reference","category":"Endpoints"},{"title":"Create multiple customers","content":"Create a batch of customer accounts from an array. Each customer is validated independently - partial success is possible.\n\nReturns the created customers and any validation errors:\n\n```json\n{\n  \"creat","url":"/api-reference/index.html#operation-customer-createmultiple-post","method":"post","path":"/customer/createMultiple","tab":"API Reference","category":"Endpoints"},{"title":"Customer login","content":"Authenticate a customer and receive a session token. The token expires after 24 hours.","url":"/api-reference/index.html#operation-customer-login-post","method":"post","path":"/customer/login","tab":"API Reference","category":"Endpoints"},{"title":"Customer logout","content":"End the current customer session and invalidate the session token.","url":"/api-reference/index.html#operation-customer-logout-get","method":"get","path":"/customer/logout","tab":"API Reference","category":"Endpoints"},{"title":"Get customer by username","content":"Retrieve a customer's profile by their username.","url":"/api-reference/index.html#operation-customer-username-get","method":"get","path":"/customer/{username}","tab":"API Reference","category":"Endpoints"},{"title":"Update customer profile","content":"Update a customer's profile. Can only be performed by the authenticated customer.","url":"/api-reference/index.html#operation-customer-username-put","method":"put","path":"/customer/{username}","tab":"API Reference","category":"Endpoints"},{"title":"Delete customer account","content":"Permanently delete a customer account and all associated data. This action cannot be undone.","url":"/api-reference/index.html#operation-customer-username-delete","method":"delete","path":"/customer/{username}","tab":"API Reference","category":"Endpoints"},{"title":"Cheese","content":"","url":"/api-reference/index.html#definition-cheese","tab":"API Reference","category":"Models"},{"title":"CheeseInput","content":"","url":"/api-reference/index.html#definition-cheeseinput","tab":"API Reference","category":"Models"},{"title":"CheeseList","content":"Paginated list of cheeses","url":"/api-reference/index.html#definition-cheeselist","tab":"API Reference","category":"Models"},{"title":"Category","content":"","url":"/api-reference/index.html#definition-category","tab":"API Reference","category":"Models"},{"title":"Tag","content":"","url":"/api-reference/index.html#definition-tag","tab":"API Reference","category":"Models"},{"title":"Order","content":"","url":"/api-reference/index.html#definition-order","tab":"API Reference","category":"Models"},{"title":"OrderInput","content":"","url":"/api-reference/index.html#definition-orderinput","tab":"API Reference","category":"Models"},{"title":"OrderItem","content":"","url":"/api-reference/index.html#definition-orderitem","tab":"API Reference","category":"Models"},{"title":"Address","content":"","url":"/api-reference/index.html#definition-address","tab":"API Reference","category":"Models"},{"title":"Customer","content":"","url":"/api-reference/index.html#definition-customer","tab":"API Reference","category":"Models"},{"title":"CustomerInput","content":"","url":"/api-reference/index.html#definition-customerinput","tab":"API Reference","category":"Models"},{"title":"Error","content":"","url":"/api-reference/index.html#definition-error","tab":"API Reference","category":"Models"},{"title":"ValidationError","content":"","url":"/api-reference/index.html#definition-validationerror","tab":"API Reference","category":"Models"},{"title":"Introduction","content":"The world's finest artis